#!/usr/bin/env python3
"""Fake osascript for the macOS clipboard: a script that sets the pasteboard string reads stdin into the fake clipboard
and records the concealed marker when it asks for org.nspasteboard.ConcealedType; clearContents alone clears it."""
import os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _fake
_fake.log("osascript")
src = " ".join(sys.argv[1:])
clip, marker = _fake.path("clipboard"), _fake.path("clipboard.concealed")
if "setStringForType" in src:
    open(clip, "wb").write(sys.stdin.buffer.read())
    if "org.nspasteboard.ConcealedType" in src:
        open(marker, "w").write("concealed\n")
    elif os.path.exists(marker):
        os.remove(marker)
elif "clearContents" in src:
    open(clip, "wb").close()
    if os.path.exists(marker):
        os.remove(marker)
