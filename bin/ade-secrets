#!/bin/bash -p
# ade-secrets: a local-only key store (the macOS Keychain, pass, or an age-encrypted file store) for ADE.
# It refuses inside an agent session (an accident guard, not a boundary); `get` serves Claude Code's key helper, and
# only entries the user enabled for it (`set --helper`), which Claude Code and anything it runs can read. Values travel
# on stdin and pipes only: never in an argument, the environment, a log, the screen or a file outside the store.
# Bash 3.2 compatible. See README.md and docs/contract.md.
# `bash -p`: no exported functions, BASH_ENV or SHELLOPTS from the environment. Started some other way, start again so.
case "$-" in *p*) ;; *) exec /bin/bash -p "$0" "$@" ;; esac
set +o xtrace +o verbose +o allexport
set -u
umask 077
ME=ade-secrets
HERE="$(cd "$(dirname "$0")" && pwd)"
HOME_DIR="${ADE_SECRETS_HOME:-$HOME/.ade-secrets}"
META="$HOME_DIR/meta"            # name, store, kind, used-by, created, rotated, helper: never a value
AGE_DIR="$HOME_DIR/age"
SVC=ade-secrets                  # the Keychain service and the pass folder
VAL=""                           # the one value in flight: a shell variable, never exported
AGE_ID="" AGE_R=""               # the age identity (decrypted for one command, in memory only) and its recipient

USAGE="usage: ade-secrets <command> (run it in your own terminal)
  list [--names]                          names, kinds, used-by, age; never values
  set <name> [--clipboard] [--kind K] [--used-by U] [--helper|--no-helper]
                                          hidden prompt, or from the clipboard (then cleared)
  copy <name> [--for N]                   to the clipboard, cleared after N s (default 10) if unchanged
  forget <name>                           after typing the name
  store [keychain|pass|age]               show the recorded store, or switch it (the only way it changes)
  lock | unlock | status                  unlock creates the age store; it keeps no session
  get <name> | helper <name>              for Claude Code's key helper (apiKeyHelper), entries set --helper only
The first store comes from ADE_SECRETS_STORE=keychain|pass|age and is recorded; it is never switched silently."

say() { printf '%s\n' "$ME: $*" >&2; }
die() { local c="$1"; shift; VAL="" AGE_ID=""; say "$*"; exit "$c"; }
refuse() { die 3 "refused: $1"; }

# ---------------------------------------------------------------- local only: agent-context detection
# Claude Code sets these in the processes it spawns (Bash tool, hooks, status line, MCP servers; docs/contract.md).
SESSION_VARS="CLAUDECODE CLAUDE_CODE_CHILD_SESSION CLAUDE_PID CLAUDE_CODE_SESSION_ID CLAUDE_CODE_BRIDGE_SESSION_ID
 CLAUDE_PROJECT_DIR CLAUDE_PLUGIN_ROOT CLAUDE_CODE_EXECPATH CLAUDE_CODE_SSE_PORT CLAUDE_CODE_ENTRYPOINT"
# session_var [helper]: the first session variable that is set (the key helper inherits CLAUDE_CODE_ENTRYPOINT)
session_var() {
  local v
  for v in $SESSION_VARS; do
    [ "${1:-}" = helper ] && [ "$v" = CLAUDE_CODE_ENTRYPOINT ] && continue
    if eval "[ -n \"\${$v+x}\" ]"; then echo "$v"; return 0; fi
  done
  return 1
}
parent_of() { local p; p="$(/bin/ps -o ppid= -p "$1" 2>/dev/null)"; printf '%s\n' "${p//[[:space:]]/}"; }
is_claude() {
  local c a w; c="$(/bin/ps -o comm= -p "$1" 2>/dev/null)"; a="$(/bin/ps -ww -o args= -p "$1" 2>/dev/null)"
  case "${c##*/}" in claude) return 0 ;; esac
  case "$a" in *@anthropic-ai/claude-code/*|*/claude/versions/*) return 0 ;; esac
  set -f; set -- $a; set +f
  for w in "${1:-}" "${2:-}"; do case "${w##*/}" in claude) return 0 ;; esac; done
  return 1
}
is_shell() {
  local a w; a="$(/bin/ps -ww -o args= -p "$1" 2>/dev/null)"; set -f; set -- $a; set +f
  w="${1:-}"; w="${w##*/}"; w="${w#-}"
  case "$w" in sh|bash|dash|zsh|ksh|mksh|ash) return 0 ;; esac
  return 1
}
# claude_ancestor: a claude process anywhere above this one (an unreadable process table counts as one: fail closed)
claude_ancestor() {
  local p="$PPID" n=0
  while [ -n "$p" ] && [ "$p" -gt 1 ] && [ $n -lt 100 ]; do
    is_claude "$p" && return 0
    p="$(parent_of "$p")"; n=$((n + 1))
  done
  [ -z "$p" ]
}
# helper_parent: claude started this, directly or through shells only (Claude Code runs the helper with /bin/sh)
helper_parent() {
  local p="$PPID" n=0
  while [ -n "$p" ] && [ "$p" -gt 1 ] && [ $n -lt 4 ]; do
    is_claude "$p" && return 0
    is_shell "$p" || return 1
    p="$(parent_of "$p")"; n=$((n + 1))
  done
  return 1
}
guard_local() {
  local v
  v="$(session_var)" && refuse "run this in your own terminal, not inside an agent session ($v is set)"
  claude_ancestor && refuse "run this in your own terminal, not inside an agent session (a claude process started it)"
  [ -t 0 ] || refuse "run this in your own terminal (there is no terminal here)"
}
# guard_helper: an accident guard only. Claude Code gives its key helper no marker, so anything Claude Code runs can
# look like the helper (unset the variables, run through /bin/sh); what keeps other keys out is the --helper allow-list.
guard_helper() {
  local v
  v="$(session_var helper)" && refuse "get answers only Claude Code's key helper, not a tool, hook or MCP server ($v is set)"
  { [ -t 0 ] || [ -t 1 ] || [ -t 2 ]; } && refuse "get answers only Claude Code's key helper; in your own terminal use: ade-secrets copy <name>"
  helper_parent || refuse "get answers only Claude Code's key helper (claude did not start it)"
}

# ---------------------------------------------------------------- names, labels, metadata
valid_name() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || die 2 "a name is letters, digits, '.', '_' or '-' (up to 64)"; }
valid_label() { [[ "$1" =~ ^[A-Za-z0-9._:/@+-]{1,64}$ ]] || die 2 "a kind or used-by label is up to 64 letters, digits or ._:/@+-"; }
dir_mode() { stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1" 2>/dev/null; }
# private_dir <dir> [create]: the folder is a real folder (not a symlink), the user's own, mode 700; never repaired
private_dir() {
  [ -L "$1" ] && die 1 "$1 is a symlink; refused (the store folders must be real folders)"
  if [ ! -e "$1" ]; then
    [ "${2:-}" = create ] || return 0
    mkdir -m 700 "$1" 2>/dev/null || die 1 "cannot create $1"
  fi
  [ -d "$1" ] || die 1 "$1 is not a folder; refused"
  [ -O "$1" ] || die 1 "$1 is not owned by you; refused"
  [ "$(dir_mode "$1")" = 700 ] || die 1 "$1 must be mode 700 (only you); refused: chmod 700 '$1' if it is yours"
}
ensure_home() { private_dir "$HOME_DIR" create; }
# same_but_case <name>: an entry of the current store whose name differs from <name> only in case
same_but_case() {
  [ -f "$META" ] || return 1
  awk -F'\t' -v n="$1" -v s="$STORE" '$2 == s && $1 != n && tolower($1) == tolower(n) { print $1; f = 1; exit } END { exit !f }' "$META"
}
meta_line() { [ -f "$META" ] && awk -F'\t' -v n="$1" -v s="$2" '$1 == n && $2 == s { print; f = 1; exit } END { exit !f }' "$META"; }
meta_field() { printf '%s\n' "$1" | cut -f "$2"; }
meta_put() { # name store kind used-by created rotated helper
  local tmp="$META.tmp.$$"
  { [ -f "$META" ] && awk -F'\t' -v n="$1" -v s="$2" '!($1 == n && $2 == s)' "$META"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$@"; } > "$tmp" && mv "$tmp" "$META"
}
meta_del() {
  local tmp="$META.tmp.$$"
  [ -f "$META" ] && awk -F'\t' -v n="$1" -v s="$2" '!($1 == n && $2 == s)' "$META" > "$tmp" && mv "$tmp" "$META"
}
meta_names() { [ -f "$META" ] && awk -F'\t' -v s="$1" '$2 == s { print $1 }' "$META" | sort; return 0; }

# ---------------------------------------------------------------- the store (chosen explicitly, never switched silently)
# The first store comes from ADE_SECRETS_STORE and is recorded once; after that only `ade-secrets store <name>` changes
# it, and an ADE_SECRETS_STORE that differs from the record is refused, not followed.
STORE="" RECORDED=""
valid_store() { case "$1" in keychain|pass|age) return 0 ;; esac; return 1; }
read_recorded() {
  RECORDED=""
  [ -f "$HOME_DIR/store" ] || return 0
  RECORDED="$(cat "$HOME_DIR/store")"
  valid_store "$RECORDED" || die 1 "$HOME_DIR/store names no known store; fix it with: ade-secrets store keychain|pass|age"
}
need_tools() {
  local need t
  case "$1" in keychain) need=security ;; pass) need=pass ;; age) need="age age-keygen" ;; esac
  for t in $need; do
    command -v "$t" >/dev/null 2>&1 || die 1 "the $1 store needs the $t command; it is not switched to another store"
  done
}
pick_store() { # [quiet]
  read_recorded
  local want="${ADE_SECRETS_STORE:-}"
  if [ -n "$want" ]; then
    valid_store "$want" || die 2 "unknown store (ADE_SECRETS_STORE=keychain|pass|age)"
    [ -z "$RECORDED" ] || [ "$RECORDED" = "$want" ] ||
      die 2 "ADE_SECRETS_STORE=$want but the recorded store is $RECORDED; nothing is switched silently: to switch, run ade-secrets store $want"
    STORE="$want"
  else
    STORE="$RECORDED"
  fi
  [ -n "$STORE" ] || die 2 "choose a store first: ADE_SECRETS_STORE=keychain|pass|age for the first set, or ade-secrets store <name> (it is never guessed)"
  need_tools "$STORE"
  [ "$STORE" = age ] && { private_dir "$AGE_DIR"; private_dir "$AGE_DIR/entries"; }
  [ "${1:-}" = quiet ] && return 0
  report_left
}
# record_store: written once, when no store is recorded yet
record_store() { [ -n "$RECORDED" ] || { printf '%s\n' "$STORE" > "$HOME_DIR/store"; RECORDED="$STORE"; }; }
# report_left: entries kept in another store than the current one
report_left() {
  [ -f "$META" ] || return 0
  local s names n
  for s in keychain pass age; do
    [ "$s" = "$STORE" ] && continue
    names="$(meta_names "$s" | tr '\n' ' ')"; names="${names% }"
    [ -n "$names" ] || continue
    n=$(printf '%s\n' $names | wc -l | tr -d ' ')
    say "$n $( [ "$n" = 1 ] && echo entry || echo entries) left in $s: $names (ade-secrets store $s reaches them)"
  done
}
# known <name>: an entry of the current store, or a pointer to the store that has it
known() {
  meta_line "$1" "$STORE" >/dev/null && return 0
  local s; for s in keychain pass age; do
    meta_line "$1" "$s" >/dev/null && die 1 "$1 is in the $s store, not $STORE; ade-secrets store $s reaches it"
  done
  die 1 "no entry named $1 in the $STORE store"
}

q() { local s="${1//\\/\\\\}"; printf '"%s"' "${s//\"/\\\"}"; }
# kc_mdat <name>: the Keychain item's modification time (attributes only: no value is read, so no dialog)
kc_mdat() {
  security find-generic-password -s "$SVC" -a "$1" 2>/dev/null |
    sed -n 's/.*"mdat"<timedate>=[^"]*"\([0-9]\{14\}Z\).*/\1/p' | head -1
}
# put_value <name> <helper yes|no> <recreate yes|no>; the value is $VAL
put_value() {
  case "$STORE" in
    keychain) # on stdin (security -i), so it is never a process argument. -i hides a failure, and reading the value
      # back would raise the allow dialog again, so the result is checked through the item's mdat.
      local before after trust='""'
      [ "$2" = yes ] && trust=/usr/bin/security   # helper entries trust security; all others trust no application
      before="$(kc_mdat "$1")"
      if [ -n "$before" ] && [ "$3" = yes ]; then  # the trusted list changes: delete, then add afresh
        security delete-generic-password -s "$SVC" -a "$1" >/dev/null 2>&1
        [ -z "$(kc_mdat "$1")" ] || return 1
        before=""
      fi
      if [ -z "$before" ]; then
        printf 'add-generic-password -s %s -a %s -T %s -w %s\n' "$(q "$SVC")" "$(q "$1")" "$trust" "$(q "$VAL")" | security -i >/dev/null 2>&1
        [ -n "$(kc_mdat "$1")" ]
      else
        while [ "$(date -u +%Y%m%d%H%M%SZ)" = "$before" ]; do sleep 0.2; done  # so a change shows in mdat
        printf 'add-generic-password -U -s %s -a %s -w %s\n' "$(q "$SVC")" "$(q "$1")" "$(q "$VAL")" | security -i >/dev/null 2>&1
        after="$(kc_mdat "$1")"
        [ -n "$after" ] && [ "$after" != "$before" ]
      fi ;;
    pass) printf '%s\n' "$VAL" | pass insert -m -f "$SVC/$1" >/dev/null 2>&1 ;;
    age) local f="$AGE_DIR/entries/$1.age" tmp; tmp="$f.tmp.$$"
      if printf '%s' "$VAL" | age -r "$AGE_R" -o "$tmp" 2>/dev/null; then mv "$tmp" "$f"
      else rm -f "$tmp"; return 1; fi ;;
  esac
}
get_value() { # name: the value on stdout (only ever into a pipe or $(...))
  case "$STORE" in
    keychain) security find-generic-password -s "$SVC" -a "$1" -w 2>/dev/null ;;
    pass) pass show "$SVC/$1" 2>/dev/null ;;
    age) age -d -i <(printf '%s\n' "$AGE_ID") "$AGE_DIR/entries/$1.age" 2>/dev/null ;;
  esac
}
value_present() {
  case "$STORE" in
    keychain) security find-generic-password -s "$SVC" -a "$1" >/dev/null 2>&1 ;;
    pass) pass show "$SVC/$1" >/dev/null 2>&1 ;;
    age) [ -f "$AGE_DIR/entries/$1.age" ] ;;
  esac
}
del_value() {
  case "$STORE" in
    keychain) security delete-generic-password -s "$SVC" -a "$1" >/dev/null 2>&1 ;;
    pass) pass rm -f "$SVC/$1" >/dev/null 2>&1 ;;
    age) rm -f "$AGE_DIR/entries/$1.age" ;;
  esac
}

# ---------------------------------------------------------------- the age store: no session, ever
# The identity is decrypted with the passphrase for each command that needs it, kept in a shell variable and handed
# to age on a pipe; nothing plaintext is written to disk. The recipient is derived from the identity, never read from
# a file someone could swap.
age_open() {
  [ -f "$AGE_DIR/identity.age" ] || die 5 "the age store is not created yet: run ade-secrets unlock"
  AGE_ID="$(age -d "$AGE_DIR/identity.age")" && [ -n "$AGE_ID" ] || die 5 "wrong passphrase; the age store stays locked"
  AGE_R="$(printf '%s\n' "$AGE_ID" | age-keygen -y 2>/dev/null | head -1)"
  [ -n "$AGE_R" ] || die 1 "the age identity gives no recipient"
}
need_open() { [ "$STORE" != age ] || age_open; }

# ---------------------------------------------------------------- the clipboard
JXA_PUT='ObjC.import("AppKit"); var d = $.NSFileHandle.fileHandleWithStandardInput.readDataToEndOfFile;
var s = $.NSString.alloc.initWithDataEncoding(d, $.NSUTF8StringEncoding); var pb = $.NSPasteboard.generalPasteboard;
pb.clearContents; pb.setStringForType(s, "public.utf8-plain-text");
pb.setStringForType("", "org.nspasteboard.ConcealedType"); pb.setStringForType("", "org.nspasteboard.TransientType"); undefined'
JXA_CLEAR='ObjC.import("AppKit"); $.NSPasteboard.generalPasteboard.clearContents; undefined'
CLIP=""
clip_need() {
  local k="${ADE_SECRETS_CLIPBOARD:-}"
  if [ -z "$k" ]; then
    if [ "$(uname -s)" = Darwin ]; then k=macos
    elif [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then k=wayland
    elif [ -n "${DISPLAY:-}" ] && command -v xclip >/dev/null 2>&1; then k=xclip
    elif [ -n "${DISPLAY:-}" ] && command -v xsel >/dev/null 2>&1; then k=xsel
    else k=none; fi
  fi
  case "$k" in macos|wayland|xclip|xsel|none) ;; *) die 2 "unknown clipboard (ADE_SECRETS_CLIPBOARD=macos|wayland|xclip|xsel)" ;; esac
  # over SSH the pasteboard is the remote machine's, or there is none
  if [ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]; then
    [ "$k" = macos ] && k=none
    [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] || k=none
  fi
  [ "$k" = none ] && die 4 "no clipboard here (over SSH, or without a display, there is none to use); run this in a local terminal"
  CLIP="$k"
}
clip_put() {
  case "$CLIP" in
    macos) osascript -l JavaScript -e "$JXA_PUT" >/dev/null 2>&1 ;;
    wayland) wl-copy >/dev/null 2>&1 ;;
    xclip) xclip -selection clipboard -in >/dev/null 2>&1 ;;
    xsel) xsel --clipboard --input >/dev/null 2>&1 ;;
  esac
}
clip_get() {
  case "$CLIP" in
    macos) pbpaste 2>/dev/null ;;
    wayland) wl-paste --no-newline 2>/dev/null ;;
    xclip) xclip -selection clipboard -out 2>/dev/null ;;
    xsel) xsel --clipboard --output 2>/dev/null ;;
  esac
}
clip_clear() {
  case "$CLIP" in
    macos) osascript -l JavaScript -e "$JXA_CLEAR" >/dev/null 2>&1 ;;
    wayland) wl-copy --clear >/dev/null 2>&1 ;;
    xclip) printf '' | xclip -selection clipboard -in >/dev/null 2>&1 ;;
    xsel) xsel --clipboard --clear >/dev/null 2>&1 ;;
  esac
}
digest() { python3 -c 'import hashlib, sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())'; }
# start_clearer <digest> <seconds>: clear the clipboard later, only if it still holds what was copied
start_clearer() {
  ( trap '' HUP; exec </dev/null >/dev/null 2>&1; sleep "$2"
    [ "$(clip_get | digest)" = "$1" ] && clip_clear ) &
}

# ---------------------------------------------------------------- commands
cmd_list() {
  if [ "${1:-}" = --names ]; then meta_names "$STORE"; return 0; fi
  [ $# -eq 0 ] || die 2 "$USAGE"
  printf '%-24s %-12s %-16s %-6s %s\n' NAME KIND USED-BY AGE HELPER
  [ -f "$META" ] || return 0
  awk -F'\t' -v s="$STORE" -v now="$(date +%s)" '
    function age(t,  d) { d = now - t; if (d >= 86400) return int(d / 86400) "d"; if (d >= 3600) return int(d / 3600) "h";
      if (d >= 60) return int(d / 60) "m"; return "now" }
    $2 == s { printf "%-24s %-12s %-16s %-6s %s\n", $1, $3, $4, age($6), ($7 == "yes" ? "yes" : "-") }' "$META" | sort
}

cmd_set() {
  [ $# -ge 1 ] || die 2 "$USAGE"
  local name="$1" from=prompt kind="" used="" helper="" old now other recreate=no; shift; valid_name "$name"
  while [ $# -gt 0 ]; do
    case "$1" in
      --clipboard) from=clipboard ;;
      --kind) [ $# -ge 2 ] || die 2 "$USAGE"; valid_label "$2"; kind="$2"; shift ;;
      --used-by) [ $# -ge 2 ] || die 2 "$USAGE"; valid_label "$2"; used="$2"; shift ;;
      --helper) helper=yes ;;
      --no-helper) helper=no ;;
      *) die 2 "$USAGE" ;;
    esac; shift
  done
  # pass and age keep a file per name and macOS paths ignore case: names that differ only in case are one name
  other="$(same_but_case "$name")" && die 2 "$name differs from the entry $other only in case; refused (use $other)"
  if old="$(meta_line "$name" "$STORE")"; then
    [ -n "$helper" ] || helper="$(meta_field "$old" 7)"
    [ "$helper" = "$(meta_field "$old" 7)" ] || recreate=yes
  else
    recreate=yes   # an item with no record of ours: re-created with the trusted list this entry needs
  fi
  [ "$helper" = yes ] || helper=no
  if [ $from = clipboard ]; then
    clip_need
    # the user put a key on the clipboard for this: it is cleared however this ends
    trap 'VAL=""; clip_clear' EXIT; trap 'exit 130' INT TERM HUP
  fi
  need_open
  if [ $from = clipboard ]; then
    VAL="$(clip_get)"
    [ -n "$VAL" ] || die 1 "the clipboard is empty; nothing stored"
  else
    IFS= read -r -s -p "value for $name (hidden): " VAL </dev/tty || die 1 "no value read; nothing stored"
    printf '\n' >&2
    [ -n "$VAL" ] || die 1 "empty; nothing stored"
  fi
  case "$VAL" in *$'\n'*|*$'\r'*) die 1 "a value is one line; nothing stored$( [ $from = clipboard ] && echo '; the clipboard is cleared')" ;; esac
  put_value "$name" "$helper" "$recreate" || die 1 "could not store $name in the $STORE store (refused in the macOS dialog, or the store failed)"
  VAL="" AGE_ID=""
  now="$(date +%s)"
  if [ -n "$old" ]; then
    [ -n "$kind" ] || kind="$(meta_field "$old" 3)"; [ -n "$used" ] || used="$(meta_field "$old" 4)"
    meta_put "$name" "$STORE" "$kind" "$used" "$(meta_field "$old" 5)" "$now" "$helper"
  else
    meta_put "$name" "$STORE" "${kind:-secret}" "${used:--}" "$now" "$now" "$helper"
  fi
  record_store
  say "stored $name in the $STORE store$( [ $from = clipboard ] && echo '; the clipboard is cleared')"
}

cmd_copy() {
  [ $# -ge 1 ] || die 2 "$USAGE"
  local name="$1" secs=10 h; shift; valid_name "$name"
  while [ $# -gt 0 ]; do
    case "$1" in
      --for) [ $# -ge 2 ] || die 2 "$USAGE"; secs="$2"; shift ;;
      *) die 2 "$USAGE" ;;
    esac; shift
  done
  case "$secs" in ''|*[!0-9]*) die 2 "--for takes seconds, 1 to 3600" ;; esac
  { [ "$secs" -ge 1 ] && [ "$secs" -le 3600 ]; } || die 2 "--for takes seconds, 1 to 3600"
  known "$name"; clip_need; need_open
  VAL="$(get_value "$name")" || die 1 "could not read $name from the $STORE store"
  AGE_ID=""
  [ -n "$VAL" ] || die 1 "could not read $name from the $STORE store"
  printf '%s' "$VAL" | clip_put || die 1 "could not reach the clipboard"
  h="$(printf '%s' "$VAL" | digest)"; VAL=""
  start_clearer "$h" "$secs"
  say "copied $name to the clipboard; it clears in $secs s unless you copy something else"
}

cmd_forget() {
  [ $# -eq 1 ] || die 2 "$USAGE"
  local name="$1" typed; valid_name "$name"; known "$name"
  IFS= read -r -p "forget $name from the $STORE store? type the name to confirm: " typed </dev/tty || typed=""
  [ "$typed" = "$name" ] || die 1 "not confirmed; nothing removed"
  del_value "$name"
  value_present "$name" && die 1 "could not remove $name from the $STORE store"
  meta_del "$name" "$STORE"
  say "forgot $name"
}

cmd_store() {
  [ $# -le 1 ] || die 2 "$USAGE"
  read_recorded
  if [ $# -eq 0 ]; then
    [ -n "$RECORDED" ] || die 2 "no store is recorded yet: ade-secrets store keychain|pass|age (or ADE_SECRETS_STORE for the first set)"
    echo "store: $RECORDED (recorded)"; STORE="$RECORDED"; report_left; return 0
  fi
  valid_store "$1" || die 2 "unknown store: ade-secrets store keychain|pass|age"
  need_tools "$1"
  STORE="$1"
  if [ "$RECORDED" = "$1" ]; then say "the store is already $1"
  else
    printf '%s\n' "$1" > "$HOME_DIR/store"
    if [ -n "$RECORDED" ]; then say "switched store: $RECORDED -> $1; nothing was moved"; else say "store: $1 recorded"; fi
    RECORDED="$1"
  fi
  report_left
}

cmd_unlock() {
  [ "$STORE" = age ] || { say "the $STORE store has no session to unlock"; return 0; }
  private_dir "$AGE_DIR" create; private_dir "$AGE_DIR/entries" create
  if [ -f "$AGE_DIR/identity.age" ]; then
    age_open; AGE_ID=""
    say "the passphrase is right; the age store keeps no session (set and copy ask for it each time)"
    return 0
  fi
  local id r
  say "a new age store: choose its passphrase"
  id="$(age-keygen 2>/dev/null)" || die 1 "age-keygen failed"
  r="$(printf '%s\n' "$id" | sed -n 's/^# public key: //p')"
  [ -n "$r" ] || { id=""; die 1 "age-keygen gave no public key"; }
  if ! printf '%s\n' "$id" | age -p -o "$AGE_DIR/identity.age.tmp"; then
    id=""; rm -f "$AGE_DIR/identity.age.tmp"; die 1 "the store was not created"
  fi
  id=""
  mv "$AGE_DIR/identity.age.tmp" "$AGE_DIR/identity.age"
  record_store
  say "created the age store; it keeps no session: set and copy ask for the passphrase each time"
}

cmd_lock() {
  case "$STORE" in
    age) say "the age store keeps no session (each set and copy asks for the passphrase); nothing to lock" ;;
    *) say "the $STORE store has no session to lock" ;;
  esac
}

cmd_status() {
  local n; n="$(meta_names "$STORE" | wc -l | tr -d ' ')"
  printf 'store: %s%s\nentries: %s\n' "$STORE" "$( [ -n "$RECORDED" ] && echo ' (recorded)' || echo ' (ADE_SECRETS_STORE, recorded on the first set)')" "$n"
  if [ "$STORE" = age ]; then
    if [ -f "$AGE_DIR/identity.age" ]; then echo "age store: locked; it keeps no session (set and copy ask for the passphrase)"
    else echo "age store: not created yet (run ade-secrets unlock)"; fi
  fi
}

cmd_get() {
  [ $# -eq 1 ] || die 2 "usage: ade-secrets get <name>"
  local name="$1" line; valid_name "$name"
  line="$(meta_line "$name" "$STORE")" || die 1 "no entry named $name in the $STORE store"
  [ "$(meta_field "$line" 7)" = yes ] || refuse "$name is not enabled for the key helper (in your terminal: ade-secrets set $name --helper)"
  [ "$STORE" != age ] || die 5 "the age store asks for its passphrase on every read, so it cannot serve the key helper; keep helper keys in the Keychain or pass"
  VAL="$(get_value "$name")" || die 1 "could not read $name"
  [ -n "$VAL" ] || die 1 "could not read $name"
  printf '%s\n' "$VAL"; VAL=""
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  help|-h|--help) printf '%s\n' "$USAGE"; exit 0 ;;
  version|--version) cat "$HERE/../VERSION" 2>/dev/null || echo unknown; exit 0 ;;
  get|helper) guard_helper; private_dir "$HOME_DIR"; pick_store quiet; cmd_get "$@" ;;
  store) guard_local; ensure_home; cmd_store "$@" ;;
  list|set|copy|forget|lock|unlock|status) guard_local; ensure_home; pick_store; "cmd_$cmd" "$@" ;;
  *) guard_local; die 2 "$USAGE" ;;
esac
